<?xml version="1.0" encoding="utf-8"?>
<!-- Refreshed by the app (after every sync / review from a notification, hourly, at midnight), never by the launcher. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="150dp"
    android:minResizeHeight="100dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/shell_widget_due"
    android:previewLayout="@layout/shell_widget_due"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/shell_widget_description" />
