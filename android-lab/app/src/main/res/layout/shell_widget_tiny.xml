<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, one row and narrow (2×1): the count and 学. ShellRules.WidgetSize.TINY -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shell_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/shell_widget_count"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="24"
            android:textColor="@color/shell_accent"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/shell_widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="due"
            android:textColor="@color/shell_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/shell_widget_study_circle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/shell_pill_filled"
        android:contentDescription="Study"
        android:gravity="center"
        android:text="学"
        android:textColor="@color/shell_on_accent"
        android:textSize="18sp" />
</LinearLayout>
