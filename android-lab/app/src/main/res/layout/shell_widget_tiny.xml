<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, one row and narrow (2×1): 学 with today's count as a badge, and ✏️ (the
     coach, keyboard up). Both are 48dp tap targets drawn as 42dp circles; the pair is centred so it
     fits the narrowest 2×1 a launcher reports (≈ 110dp). ShellRules.WidgetSize.TINY -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shell_widget_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp">

        <TextView
            android:id="@+id/shell_widget_study_circle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/shell_icon_filled"
            android:contentDescription="Study"
            android:gravity="center"
            android:text="学"
            android:textColor="@color/shell_on_accent"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/shell_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="@drawable/shell_badge"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="18dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="24"
            android:textColor="@color/shell_accent"
            android:textSize="11sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/shell_widget_coach"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/shell_icon_soft"
        android:contentDescription="Sentence coach"
        android:gravity="center"
        android:text="✏️"
        android:textSize="16sp" />
</LinearLayout>
