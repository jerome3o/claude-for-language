<?xml version="1.0" encoding="utf-8"?>
<!--
  The web app keeps its sign-in token in the WebView's storage (app_webview) and settings in shared
  preferences: neither goes into a cloud backup or a phone-to-phone transfer (security audit, Nov 2026).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
